# Source-only repository. Local discussions, workspaces and validation output stay untracked.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/GLOSSARY.md
!/README.md
!/install.mjs
!/package.json
!/package-lock.json
!/tsconfig.json
!/packages/
!/skills/
/skills/*
!/skills/bang/
!/tests/
/tests/*
!/tests/v2/
!/docs/
/docs/*
!/docs/agents/
!/docs/adr/
!/docs/design/
!/baselines/
/baselines/*
!/baselines/whiteboard-v1/

# Runtime state and generated files. The project config and topic exports may be shared.
node_modules/
dist/
coverage/
**/.bang/bang.db*
**/.bang/server.json*
**/.bang/credentials.json*
